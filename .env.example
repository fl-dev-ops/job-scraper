# Copy this to .env and fill in your values. Never commit .env.

# Required: OpenRouter API key for LLM extraction
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: LLM model override (default: anthropic/claude-haiku-4.5)
# Cheaper/faster: openai/gpt-4o-mini
# More accurate: anthropic/claude-sonnet-4-6
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: residential proxy URLs per site (leave blank = no proxy)
# Format: http://user:pass@host:port
NAUKRI_PROXY_URL=
INDEED_PROXY_URL=
LINKEDIN_PROXY_URL=

# Optional: global proxy fallback if site-specific ones are not set
PROXY_URL=
